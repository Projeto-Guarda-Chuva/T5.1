#!/bin/sh

set -e

echo "=== Executando testes do backend ==="

cd backend

if [ ! -d ".venv" ]; then
    echo "Ambiente virtual (.venv) não encontrado."
    exit 1
fi

.venv/bin/pytest -q

cd ..

echo "=== Executando testes do frontend (Admin Parametrização) ==="

cd frontend/admin-parametrizacao
npm run test

cd ../..

echo "=== Executando testes do frontend (Meus Vídeos) ==="

cd frontend/meus-videos
npm run test

cd ../..

echo "✅ Todos os testes passaram!"
